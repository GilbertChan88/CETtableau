model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["SourceFolder","WebTraffic","CampaignSpend","Campaign","Calendar","FactActualSpend"]

	ref table WebTraffic
	ref table CampaignSpend
	ref table Campaign
	ref table Calendar
	ref table FactActualSpend

	ref cultureInfo en-US
