model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-SG
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SourceFolder","WebTraffic","CampaignSpend","Campaign","Calendar","DigitalAdsPerf","ContentMktgPerf","OOHPerf"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table WebTraffic
ref table CampaignSpend
ref table Campaign
ref table Calendar
ref table DigitalAdsPerf
ref table ContentMktgPerf
ref table OOHPerf

