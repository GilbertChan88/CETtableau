model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SourceFolder","WebTraffic","CampaignSpend","Campaign","Calendar","FactActualSpend"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table WebTraffic
ref table CampaignSpend
ref table Campaign
ref table Calendar
ref table FactActualSpend
ref table 'Schedule View'
