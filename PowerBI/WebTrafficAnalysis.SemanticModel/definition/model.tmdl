model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SourceFolder","WebTraffic","CampaignSpend","Campaign","Calendar","FactActualSpend"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table WebTraffic
ref table CampaignSpend
ref table Campaign
ref table Calendar
ref table FactActualSpend

