// =====================================================================
// DAX MEASURES  —  Web Traffic & Campaign (Power BI replica of version-2)
// Create a measures home table (or put on the fact tables as noted).
// =====================================================================

// ---------- Web Traffic (table: WebTraffic) ----------

Total Views = SUM ( WebTraffic[Views] )

Total Users = SUM ( WebTraffic[Users] )   // column renamed from "Total users" -> "Users" to avoid a measure/column name clash

Total Sessions = SUM ( WebTraffic[Sessions] )

// Weighted average session duration in seconds (Tableau "True Avg Session Duration":
// SUM(duration*sessions)/SUM(sessions) — NOT an average of averages)
Weighted Avg Session Duration (s) =
DIVIDE (
    SUMX ( WebTraffic, WebTraffic[Average session duration] * WebTraffic[Sessions] ),
    SUM ( WebTraffic[Sessions] )
)

// Human-readable "2min 25s" (Tableau "Avg Session Duration (min sec)")
Avg Session Duration (min sec) =
VAR SecondsTotal = [Weighted Avg Session Duration (s)]
VAR Mins = INT ( DIVIDE ( SecondsTotal, 60 ) )
VAR Secs = INT ( MOD ( SecondsTotal, 60 ) )
RETURN
    IF (
        ISBLANK ( SecondsTotal ),
        BLANK (),
        FORMAT ( Mins, "0" ) & "min " & FORMAT ( Secs, "00" ) & "s"
    )

// ---------- Campaign Spend (table: CampaignSpend) ----------

Total Spend = SUM ( CampaignSpend[Total Campaign Spend] )

Total Media Cost = SUM ( CampaignSpend[Media Cost] )

Total Production Cost = SUM ( CampaignSpend[Production Cost] )

Total Agency Fee = SUM ( CampaignSpend[Calculated Agency Fee] )

// Dynamic % of the (filtered) grand total — Tableau "% of Total Spend"
% of Total Spend =
DIVIDE (
    [Total Spend],
    CALCULATE ( [Total Spend], ALLSELECTED ( CampaignSpend ) )
)

// Spend formatted as a compact label for bars/cards
Total Spend ($) = FORMAT ( [Total Spend], "$#,##0" )

// ---------- Campaign counts / schedule helpers ----------

Campaign Count = DISTINCTCOUNT ( CampaignSpend[Campaign Name] )

Platform Count = DISTINCTCOUNT ( CampaignSpend[Marketing Platform] )

// Earliest start / latest end in the current filter context (for a dynamic schedule axis)
Min Start Date = MIN ( CampaignSpend[Start Date] )
Max End Date   = MAX ( CampaignSpend[End Date] )


// ---------- Campaign Schedule (Gantt) helpers — table: CampaignSpend ----------
// Power BI has no native Gantt mark. The "Campaign Schedule" worksheet is
// reproduced with a STACKED BAR: [Gantt Start Offset (Days)] (rendered white /
// transparent) followed by [Gantt Duration (Days)] (the visible bar). Together
// they float each campaign's bar to its correct start on a shared day axis.

Platform Count = DISTINCTCOUNT ( CampaignSpend[Marketing Platform] )

// The Date slicer sits on Calendar[Date]. CampaignSpend is NOT related to
// Calendar, but a slicer still filters the whole page's filter context, so
// MIN/MAX(Calendar[Date]) "harvest" the selected Date From / Date To. Both
// Gantt measures use that window to (a) anchor the timeline to Date From and
// (b) clip each bar to the window — keeping the Campaign Schedule in sync with
// the Traffic Trend Analysis. Non-overlapping campaigns return BLANK and drop.

// Left (transparent) segment: days from Date From to the campaign start.
Gantt Start Offset (Days) =
VAR WinFrom = MIN ( Calendar[Date] )
VAR WinTo   = MAX ( Calendar[Date] )
VAR CampStart = MIN ( CampaignSpend[Start Date] )
VAR CampEnd   = MAX ( CampaignSpend[End Date] )
VAR Overlaps  = CampStart <= WinTo && CampEnd >= WinFrom
VAR ClippedStart = IF ( CampStart < WinFrom, WinFrom, CampStart )
RETURN IF ( Overlaps, DATEDIFF ( WinFrom, ClippedStart, DAY ) )

// Visible segment: campaign duration clipped to the Date From / Date To window.
Gantt Duration (Days) =
VAR WinFrom = MIN ( Calendar[Date] )
VAR WinTo   = MAX ( Calendar[Date] )
VAR CampStart = MIN ( CampaignSpend[Start Date] )
VAR CampEnd   = MAX ( CampaignSpend[End Date] )
VAR Overlaps  = CampStart <= WinTo && CampEnd >= WinFrom
VAR ClippedStart = IF ( CampStart < WinFrom, WinFrom, CampStart )
VAR ClippedEnd   = IF ( CampEnd > WinTo, WinTo, CampEnd )
RETURN IF ( Overlaps, DATEDIFF ( ClippedStart, ClippedEnd, DAY ) + 1 )
