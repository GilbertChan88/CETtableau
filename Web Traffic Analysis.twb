            <column caption='Avg Session Duration (sec)' datatype='real' name='[Calculation_3296071987586428928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Average session duration] * [Sessions]) / SUM([Sessions])' />
            </column>
            <column caption='Avg Session Duration (min sec)' datatype='string' name='[Calculation_D1DURSTR01]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(INT([Calculation_3296071987586428928] / 60)) + &quot;min &quot; + STR(INT([Calculation_3296071987586428928]) % 60) + &quot;s&quot;' />
            </column>
            <column datatype='integer' name='[Sessions]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_D1DURSTR01]' derivation='User' name='[usr:Calculation_D1DURSTR01:nk]' pivot='key' type='nominal' />
