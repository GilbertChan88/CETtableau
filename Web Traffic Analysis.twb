          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date From' datatype='date' default-format='dd/mm/yyyy' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-01-01#'>
              <calculation class='tableau' formula='#2024-01-01#' />
              <range max='#2025-12-31#' min='#2024-01-01#' />
            </column>
            <column caption='Date To' datatype='date' default-format='dd/mm/yyyy' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='#2025-03-31#'>
              <calculation class='tableau' formula='#2025-03-31#' />
              <range max='#2025-12-31#' min='#2024-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bkpira1pza2b3133tu8b1gkoqit'>
            <column datatype='real' name='[Average session duration]' role='measure' type='quantitative' />
            <column caption='Avg Session Duration (sec)' datatype='real' name='[Calculation_3296071987586428928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Average session duration] * [Sessions]) / SUM([Sessions])' />
            </column>
            <column caption='Avg Session Duration (min)' datatype='real' name='[Calculation_D1DURMIN01]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Calculation_3296071987586428928] / 60, 1)' />
            </column>
            <column caption='In Range (Traffic)' datatype='boolean' name='[Calculation_D1RANGET01]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Date] &gt;= [Parameters].[Parameter 2] AND [Date] &lt;= [Parameters].[Parameter 3]' />
