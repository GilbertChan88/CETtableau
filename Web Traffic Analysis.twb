      <aliases enabled='yes' />
      <column caption='Campaign Duration (Days)' datatype='integer' name='[Calculation_D2DUR01]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_D2START01], [Calculation_D2END01])' />
      </column>
      <column caption='Campaign End Date' datatype='date' name='[Calculation_D2END01]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM-dd HH:mm:ss&quot;, [End Date]))' />
      </column>
      <column caption='% of Total Spend' datatype='real' name='[Calculation_D2PCTTOTAL01]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Campaign Spend]) / TOTAL(SUM([Total Campaign Spend]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Campaign Start Date' datatype='date' name='[Calculation_D2START01]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM-dd HH:mm:ss&quot;, [Start Date]))' />
      </column>
      <column caption='Total Spend' datatype='real' name='[Calculation_D2TOTALSPEND01]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Campaign Spend]' />
      </column>
