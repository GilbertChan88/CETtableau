    <worksheet name='Avg Session Duration KPI'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Avg Session Duration&#10;</run>
            <run fontsize='9'>Visitor-weighted average, shown as minutes and seconds.</run>
