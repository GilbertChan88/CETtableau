    <worksheet name='Traffic Trend Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontsize='10'>Total Web Traffic Over Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Mock + Live Data' name='federated.1ndc0xs0yux68k1e2bmmz07xy1lf' />
          </datasources>
          <datasource-dependencies datasource='federated.1ndc0xs0yux68k1e2bmmz07xy1lf'>
            <column datatype='string' name='[Campaign ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Campaign Name for UTM]' role='dimension' type='nominal' />
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dept/Sch/Institute]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Total users]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Views]' role='measure' type='quantitative' />
            <column caption='Date (by Granularity)' datatype='date' name='[Calculation_D3GRAN01]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [Date])' />
            </column>
            <column caption='In Range (Traffic)' datatype='boolean' name='[Calculation_D3RANGET01]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Date] &gt;= [Parameters].[Parameter 2] AND [Date] &lt;= [Parameters].[Parameter 3]' />
            </column>
            <column-instance column='[Campaign ID]' derivation='None' name='[none:Campaign ID:nk]' pivot='key' type='nominal' />
            <column-instance column='[Campaign Name for UTM]' derivation='None' name='[none:Campaign Name for UTM:nk]' pivot='key' type='nominal' />
            <column-instance column='[Date]' derivation='None' name='[none:Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Dept/Sch/Institute]' derivation='None' name='[none:Dept/Sch/Institute:nk]' pivot='key' type='nominal' />
            <column-instance column='[Total users]' derivation='Sum' name='[sum:Total users:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Views]' derivation='Sum' name='[sum:Views:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Date]' derivation='Week-Trunc' name='[twk:Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_D3GRAN01]' derivation='None' name='[none:Calculation_D3GRAN01:qk]' pivot='key' type='quantitative' />
