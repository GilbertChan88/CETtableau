      <column caption='Duration (Days)' datatype='integer' name='[Calculation_3296071987911081986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Start Date], [End Date])' />
      </column>
      <column caption='Date (by Granularity)' datatype='date' name='[Calculation_D3GRAN01]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [Date])' />
      </column>
      <column caption='In Range (Traffic)' datatype='boolean' name='[Calculation_D3RANGET01]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Date] &gt;= [Parameters].[Parameter 2] AND [Date] &lt;= [Parameters].[Parameter 3]' />
      </column>
      <column caption='In Range (Campaign)' datatype='boolean' name='[Calculation_D3RANGEC01]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Start Date] &lt;= [Parameters].[Parameter 3] AND [End Date] &gt;= [Parameters].[Parameter 2]' />
      </column>
      <column caption='Gantt Position (Top)' datatype='real' name='[Calculation_3296071988386656259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(SUM([Views])) * 1.1'>
