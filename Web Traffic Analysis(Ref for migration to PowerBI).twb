    <worksheet name='Page Performance Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Web Traffic Analysis' name='federated.0bkpira1pza2b3133tu8b1gkoqit' />
            <datasource name='Parameters' />
            <datasource caption='Final_Campaign_Spend_Data' name='federated.0315qxo1p3wpht0znbanp1o2j6sz' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date From' datatype='date' default-format='dd/mm/yyyy' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-05-20#'>
              <calculation class='tableau' formula='#2024-05-20#' />
              <range max='#2025-12-31#' min='#2024-01-01#' />
            </column>
            <column caption='Date To' datatype='date' default-format='dd/mm/yyyy' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='#2025-06-21#'>
              <calculation class='tableau' formula='#2025-06-21#' />
              <range max='#2025-12-31#' min='#2024-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0315qxo1p3wpht0znbanp1o2j6sz'>
            <column datatype='string' name='[Campaign Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Marketing Channel]' role='dimension' type='nominal' />
            <column-instance column='[Campaign Name]' derivation='None' name='[none:Campaign Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Marketing Channel]' derivation='None' name='[none:Marketing Channel:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bkpira1pza2b3133tu8b1gkoqit'>
            <column datatype='real' name='[Average session duration]' role='measure' type='quantitative' />
            <column caption='True Avg Session Duration' datatype='real' name='[Calculation_3296071987586428928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Average session duration] * [Sessions]) / SUM([Sessions])' />
            </column>
            <column caption='In Range (Traffic)' datatype='boolean' name='[Calculation_D1RANGET01]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Date] &gt;= [Parameters].[Parameter 2] AND [Date] &lt;= [Parameters].[Parameter 3]' />
            </column>
            <column datatype='string' name='[Campaign ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Campaign Name]' role='dimension' type='nominal' />
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Marketing Channel]' role='dimension' type='nominal' />
            <column datatype='string' name='[Page path and screen class]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Sessions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Total users]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Views]' role='measure' type='quantitative' />
